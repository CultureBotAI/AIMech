  "entries": [
    {
      "id": "AIMech:AMSGrad",
      "path": "data/curated/AMSGrad.yaml",
      "disposition": "added",
      "source_key": "amsgrad",
      "locator": "Section 4 and Algorithm 2, PDF/printed p. 5",
      "identity_assessment": "The historical maximum distinguishes AMSGrad from Adam and from weight-decay decoupling in AdamW. It can be combined with other optimizer choices without becoming identical to them.",
      "inspected_method": "The method keeps first- and second-moment accumulators and a nondecreasing coordinatewise maximum of the latter; its original constrained formulation projects the resulting adaptive step onto the feasible set.",
      "aio_assessment": "related_match: AIO:TrainingStrategy"
    },
    {
      "id": "AIMech:AdamNC",
      "path": "data/curated/AdamNC.yaml",
      "disposition": "added",
      "source_key": "amsgrad",
      "locator": "Section 5.1, PDF/printed p. 8; Algorithm 3, PDF/printed p. 19",
      "identity_assessment": "AdamNC changes the moment schedules rather than taking AMSGrad's historical maximum. The named method is distinct from an arbitrary claim that any changing Adam hyperparameters ensures convergence.",
      "inspected_method": "Both moment accumulators use iteration-indexed decay coefficients; the original method scales the first-moment step by the square root of the second moment and projects it onto the feasible set.",
      "aio_assessment": "related_match: AIO:TrainingStrategy"
    },
    {
      "id": "AIMech:AStarSearch",
      "path": "data/curated/AStarSearch.yaml",
      "disposition": "added",
      "source_key": "astar",
      "locator": "Section II.A–C, printed pp. 101–102 / PDF pp. 2–3; Search Algorithm A* and equation 2",
      "identity_assessment": "This is the graph-search algorithm conventionally written A*, not a graph language model or a learned policy. Its heuristic estimate is distinct from the exact remaining path cost.",
      "inspected_method": "The procedure expands a minimum-score open node, updates successor path estimates, reopens a closed successor when a better estimate is found, and terminates when a selected node is a goal.",
      "aio_assessment": "no_suitable_match"
    },
    {
      "id": "AIMech:STRIPSPlanning",
      "path": "data/curated/STRIPSPlanning.yaml",
      "disposition": "added",
      "source_key": "strips",
